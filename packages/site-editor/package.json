{
  "name": "@thereactnativerewind/site-editor",
  "version": "0.1.0",
  "description": "Plug-in visual editor so clients can edit marked copy on a live Next.js site without a pull request or rebuild.",
  "license": "MIT",
  "author": "Luke Brandon Farrell",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "nextjs",
    "visual-editor",
    "cms",
    "vercel",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukebrandonfarrell/site-editor.git",
    "directory": "packages/site-editor"
  },
  "homepage": "https://github.com/lukebrandonfarrell/site-editor#readme",
  "bugs": {
    "url": "https://github.com/lukebrandonfarrell/site-editor/issues"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "bin": {
    "site-editor": "./dist/cli/migrate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./route": {
      "types": "./dist/next/route.d.ts",
      "import": "./dist/next/route.js",
      "default": "./dist/next/route.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/content.test.ts test/handler.test.ts test/limits.test.ts test/snapshot.test.ts",
    "test:postgres": "tsx --test test/postgres.integration.test.ts",
    "migrate": "node dist/cli/migrate.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "resend": "^6.35.0",
    "server-only": "^0.0.1"
  },
  "optionalDependencies": {
    "@vercel/blob": "^2.8.2"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
