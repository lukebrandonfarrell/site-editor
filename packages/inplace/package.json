{
  "name": "@thereactnativerewind/inplace",
  "version": "0.3.0",
  "description": "Plug-in visual editor so clients can edit marked copy on a live Next.js or Astro site without a pull request or rebuild.",
  "license": "MIT",
  "author": "Luke Brandon Farrell",
  "type": "module",
  "sideEffects": [
    "styles.css",
    "*.css"
  ],
  "keywords": [
    "nextjs",
    "astro",
    "visual-editor",
    "inline-editing",
    "cms",
    "vercel",
    "react",
    "postgres",
    "inplace"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-react-native-rewind/inplace.git",
    "directory": "packages/inplace"
  },
  "homepage": "https://github.com/the-react-native-rewind/inplace#readme",
  "bugs": {
    "url": "https://github.com/the-react-native-rewind/inplace/issues"
  },
  "files": [
    "dist",
    "astro",
    "styles.css",
    "migrations",
    "README.md"
  ],
  "bin": {
    "inplace": "./dist/cli/migrate.js",
    "site-editor": "./dist/cli/migrate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./next": {
      "types": "./dist/next/route.d.ts",
      "import": "./dist/next/route.js",
      "default": "./dist/next/route.js"
    },
    "./route": {
      "types": "./dist/next/route.d.ts",
      "import": "./dist/next/route.js",
      "default": "./dist/next/route.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "import": "./dist/astro/index.js",
      "default": "./dist/astro/index.js"
    },
    "./astro/editor": {
      "types": "./dist/astro/editor-client.d.ts",
      "import": "./dist/astro/editor-client.js",
      "default": "./dist/astro/editor-client.js"
    },
    "./astro/middleware": {
      "types": "./dist/astro/middleware.d.ts",
      "import": "./dist/astro/middleware.js",
      "default": "./dist/astro/middleware.js"
    },
    "./astro/Editable.astro": "./astro/Editable.astro",
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/content.test.ts test/handler.test.ts test/limits.test.ts test/snapshot.test.ts test/astro.test.ts test/schema.test.ts test/publish-state.test.ts",
    "test:postgres": "tsx --test test/postgres.integration.test.ts",
    "migrate": "node dist/cli/migrate.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vercel/functions": "^3.1.4",
    "pg": "^8.23.1",
    "resend": "^6.35.0",
    "server-only": "^0.0.1"
  },
  "optionalDependencies": {
    "@vercel/blob": "^2.8.2"
  },
  "peerDependencies": {
    "@astrojs/vercel": ">=8",
    "astro": ">=5",
    "next": ">=15",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@astrojs/vercel": { "optional": true },
    "astro": { "optional": true },
    "next": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
