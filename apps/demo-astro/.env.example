# Same database contract as the Next.js demo. Neon or Supabase via DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/site_editor
SITE_EDITOR_SITE_ID=demo-astro
SITE_EDITOR_ALLOWED_EMAILS=client@example.com

# Production magic links. Without RESEND_API_KEY the link is printed in the server log.
# RESEND_API_KEY=re_xxxxxxxxx
# SITE_EDITOR_FROM_EMAIL=Site Editor <editor@yourdomain.com>

# Preview and local dev open the editor without login. Set to 0 to require the allowlist.
# SITE_EDITOR_OPEN=1

# Optional. When set, publish also stores the snapshot in Vercel Blob.
# BLOB_READ_WRITE_TOKEN=
