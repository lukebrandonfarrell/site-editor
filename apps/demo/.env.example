# Required. Neon or Supabase Postgres from the Vercel Marketplace, or local Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/site_editor

# Which site's rows to read and write. One database can hold many sites.
SITE_EDITOR_SITE_ID=demo

# Production magic-link allowlist. Comma-separated. Preview deploys do not need this
# because the editor is open there without login.
SITE_EDITOR_ALLOWED_EMAILS=client@example.com

# Required on production if clients should receive real sign-in email.
# Without RESEND_API_KEY, the magic link is printed in the server log.
# RESEND_API_KEY=re_xxxxxxxxx
# SITE_EDITOR_FROM_EMAIL=Site Editor <editor@yourdomain.com>

# Public origin for sign-in links when the host is not a Vercel or localhost host.
# SITE_EDITOR_URL=https://your-domain.com

# Force the editor open (1) or force login (0). Defaults: open on VERCEL_ENV=preview
# and local development, login required on VERCEL_ENV=production.
# SITE_EDITOR_OPEN=0

# Optional durable snapshot outside Postgres (recommended on Vercel).
# BLOB_READ_WRITE_TOKEN=

# Paths revalidated after publish. Comma-separated.
# SITE_EDITOR_REVALIDATE_PATHS=/

# SITE_EDITOR_MAX_TEXT_LENGTH=8000
# SITE_EDITOR_SNAPSHOT_PATH=
